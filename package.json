{
	"name": "shadowcrypt",
	"type": "module",
	"author": "Aleksei Aliapkin <aaliapkin@gmail.com>",
	"license": "MIT",
	"version": "0.0.1",
	"description": "Yet another moodboard application",
	"repository": {
		"type": "git",
		"url": "https://github.com/mfecane/shadowcrypt"
	},
	"private": true,
	"scripts": {
		"dev": "nuxt dev",
		"start": "docker compose down -v && docker compose up -d --build --force-recreate",
		"stop": "docker compose down -v",
		"check": "nuxi typecheck && eslint . && nuxi build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --tsconfig tsconfig.seed.json scripts/seed.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.700.0",
		"@nuxt/eslint": "^1.15.2",
		"@nuxt/ui": "^4.6.0",
		"@pinia/nuxt": "^0.11.3",
		"@tanstack/vue-query": "^5.95.2",
		"@tweenjs/tween.js": "^25.0.0",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.2",
		"nodemailer": "^6.10.1",
		"nuxt": "^4.4.2",
		"nuxt-auth-utils": "^0.5.29",
		"nuxt-lucide-icons": "^2.1.0",
		"pg": "^8.20.0",
		"pinia": "^3.0.4",
		"pixi.js": "^8.17.1",
		"sharp": "^0.33.5",
		"tailwindcss": "^4.2.2",
		"tweenjs": "^1.0.2",
		"typescript-optional": "^3.0.0-alpha.3",
		"vue": "^3.5.30",
		"vue-router": "^5.0.4",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@types/nodemailer": "^6.4.17",
		"@types/pg": "^8.20.0",
		"@vue/language-core": "^3.2.6",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vue-tsc": "^3.2.6"
	}
}
